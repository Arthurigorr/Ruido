Package: Ruido
Title: A Streamline Package To Calculate Soundscape Saturation
Version: 0.0.0.9000
Authors@R: c(
    person("Arthur Igor da", "Fonseca-Freire", , "arthur.igorr@gmail.com", role = c("aut", "cre", "cph")),
